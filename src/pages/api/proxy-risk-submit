// pages/api/proxy-risk-submit.js
export default async function handler(req, res) {
  if (req.method !== 'POST') {
    res.setHeader('Allow', 'POST');
    return res.status(405).json({ success: false, error: 'Method not allowed' });
  }

  const backendUrl =
    process.env.NODE_ENV === 'production'
      ? 'https://portoflio-backend-snowy.vercel.app/api/risk/submit'
      : 'http://localhost:5000/api/risk/submit';

  try {
    // Forward necessary headers (Content-Type + optional Authorization + optional cookie)
    const headers = {
      'Content-Type': 'application/json',
      'Accept': 'application/json',
    };

    if (req.headers.authorization) {
      headers['Authorization'] = req.headers.authorization;
    }

    // Forward cookies so backend can authenticate with session cookie (NextAuth)
    if (req.headers.cookie) {
      headers['cookie'] = req.headers.cookie;
    }

    // (Optional) Forward origin or x-forwarded-for if you need backend to know caller
    if (req.headers.origin) {
      headers['Origin'] = req.headers.origin;
    }
    if (req.headers['x-forwarded-for']) {
      headers['X-Forwarded-For'] = req.headers['x-forwarded-for'];
    }

    // Debug during development
    if (process.env.NODE_ENV !== 'production') {
      // eslint-disable-next-line no-console
      console.log('proxy-risk-submit: forwarding headers', {
        hasAuthorization: !!req.headers.authorization,
        hasCookie: !!req.headers.cookie,
      });
    }

    const backendRes = await fetch(backendUrl, {
      method: 'POST',
      headers,
      body: JSON.stringify(req.body),
      redirect: 'follow',
    });

    const text = await backendRes.text();
    const contentType = backendRes.headers.get('content-type') || '';

    res.status(backendRes.status);
    if (contentType.includes('application/json')) {
      try {
        return res.json(JSON.parse(text));
      } catch (e) {
        // If parsing fails, return raw text
        return res.send(text);
      }
    } else {
      return res.send(text);
    }
  } catch (err) {
    // eslint-disable-next-line no-console
    console.error('proxy-risk-submit error', err);
    return res.status(500).json({ success: false, error: 'Proxy error' });
  }
}
